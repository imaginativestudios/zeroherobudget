# Copy to .env and fill in. Never commit .env itself.
#
# These VITE_-prefixed values are inlined into the client bundle at build time
# and are therefore public by design. Only ever put publishable/anon values here.
# Server-side secrets (SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, PLAID_SECRET,
# RESEND_API_KEY, ...) belong in Supabase Edge Function secrets, never in this file.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
