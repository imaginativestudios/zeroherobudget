{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "e2e",
    "src/integrations/supabase/types.ts",
    "src/vite-env.d.ts",
    "**/*.d.ts"
  ],
  "reporter": ["text", "html", "json-summary", "lcov"],
  "report-dir": "coverage",
  "temp-dir": ".nyc_output",
  "check-coverage": false,
  "branches": 50,
  "lines": 50,
  "functions": 50,
  "statements": 50
}
